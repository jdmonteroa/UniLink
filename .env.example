# ==============================================================================
# UNILINK - CONFIGURACIÓN DE ENTORNO (SUPABASE FRONTEND)
# ==============================================================================
# IMPORTANTE: Solo la anon public key va en el frontend.
# NUNCA agregues aquí la service_role key.
# ==============================================================================

# 1. URL de tu proyecto de Supabase (Project Settings > API > Project URL)
# Ejemplo: https://xyzcompanyref.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Clave anónima pública de Supabase (Project Settings > API > Project API keys > anon public)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# 3. URL base de la app (para redirecciones de Auth)
VITE_APP_URL=http://localhost:5173
